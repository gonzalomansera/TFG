# === Jose Halconero — variables de entorno ===
# Copia este archivo a `.env` y rellena los valores reales.

# --- API ---
# Local:       http://localhost:8000/api
# Producción:  /api   (la VPS sirve frontend y backend en el mismo dominio tras nginx)
API_URL=http://localhost:8000/api
VITE_API_URL=http://localhost:8000/api

# --- Base de datos ---
# Local (SQLite):      sqlite:///./database.db
# Producción (Postgres): postgresql+psycopg2://usuario:password@localhost:5432/halconero_db
DATABASE_URL=sqlite:///./database.db

# --- Cloudinary (almacenamiento de imágenes del portfolio) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email SMTP (para recibir las solicitudes de cita en el correo del estudio) ---
# Opcional: si se deja vacío, las citas se guardan igualmente en la base de datos.
# Ejemplo con IONOS: SMTP_HOST=smtp.ionos.es  SMTP_PORT=587 (STARTTLS) o 465 (SSL)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL=

# --- Login con Google (app de gestión /gestion) ---
# Crea un "ID de cliente de OAuth" (tipo Web) en https://console.cloud.google.com
# y añade tu dominio a los orígenes autorizados.
VITE_GOOGLE_CLIENT_ID=
# Email de Google que tendrá acceso de administrador (se da de alta solo la 1ª vez).
ADMIN_EMAIL=

# --- CORS (producción) ---
# Déjalo vacío/sin definir en local. En producción: dominios separados por comas.
# ALLOWED_ORIGINS=https://josehalconero.com,https://www.josehalconero.com
